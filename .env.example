# Copy this file to .env and fill in the two keys. .env is git-ignored.

# Generator (Claude) and embeddings/judge (OpenAI). Both are pay-as-you-go.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional overrides (defaults shown)
# GENERATOR_MODEL=claude-haiku-5-5
# JUDGE_REPEATS=3   # judgings (1 to 9) of most judged checks, scored as their median (Faithfulness and the report-only metrics are always judged once); 1 judges every check once, at a lower cost
# EMBEDDING_MODEL=text-embedding-3-small
# TOP_K=4

# Judge models. Leave them all unset for the defaults: gpt-4o-mini for every judged check except
# the two Faithfulness checks, which use gpt-5-mini. Setting JUDGE_MODEL moves EVERY judged check,
# both Faithfulness checks included, to that model, so uncommenting JUDGE_MODEL=gpt-4o-mini gives
# up the Faithfulness upgrade.
# JUDGE_MODEL=claude-haiku-5-5   # an example; same model family as the generator, so scores may be biased
# A metric's own judge is JUDGE_MODEL_ plus its key in capitals, and beats JUDGE_MODEL:
# JUDGE_MODEL_FAITHFULNESS=gpt-5-mini
# JUDGE_MODEL_BIAS_FAITHFULNESS=gpt-5-mini

# Optional: upload full eval runs to the Confident AI dashboard (free plan: 5 runs/week)
# CONFIDENT_API_KEY=

# DeepEval sends anonymous usage data unless you opt out
DEEPEVAL_TELEMETRY_OPT_OUT=YES
