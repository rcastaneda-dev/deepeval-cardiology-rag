# Copy this file to .env and fill in the two keys. .env is git-ignored.

# Generator (Claude) and embeddings/judge (OpenAI). Both are pay-as-you-go.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional overrides (defaults shown)
# GENERATOR_MODEL=claude-haiku-5-5
# JUDGE_MODEL=gpt-4o-mini
# JUDGE_MODEL=claude-haiku-5-5   # alternative judge; same model family as the generator, so scores may be biased
# EMBEDDING_MODEL=text-embedding-3-small
# TOP_K=4

# Optional: upload full eval runs to the Confident AI dashboard (free plan: 5 runs/week)
# CONFIDENT_API_KEY=

# DeepEval sends anonymous usage data unless you opt out
DEEPEVAL_TELEMETRY_OPT_OUT=YES
